rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product images and videos: public read, authenticated write (admin upload)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 52428800; // 50 MB max
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
